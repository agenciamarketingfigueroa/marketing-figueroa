# Copiar para .env.local (ignorado pelo Git). Não preencher este arquivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Identificadores cadastrados no banco; segredos somente no servidor.
SYNC_ORGANIZATION_ID=
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Versão suportada pelo aplicativo Meta, explícita; ex.: vXX.0
META_GRAPH_VERSION=
META_HISTORY_START=2026-08-21
# Instagram profissional vinculado a Página; token de leitura autorizado.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USERNAME=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=
HOTMART_ACCOUNT_ID=
# IDs numéricos separados por vírgula. Obrigatório; restringe a importação à operação.
HOTMART_PRODUCT_IDS=
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_AUTH=
HOTMART_HOTTOK=
# ID ucode do participante financeiro da operação, conferido pelo administrador.
# Opcional; sem ele não apuramos líquido a partir de comissões.
HOTMART_PARTICIPANT_ID=
# Pelo menos 32 caracteres aleatórios, armazenado também no Supabase Vault.
CRON_SECRET=
# Demonstração separada, nunca fallback automático de dados reais.
ENABLE_DEMO=false
# Início da conciliação, em UTC. Configurar no onboarding.
HOTMART_HISTORY_START=2026-08-21
